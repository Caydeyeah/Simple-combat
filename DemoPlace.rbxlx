<?xml version='1.0' encoding='utf-8'?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace"><Properties><string name="Name">Workspace</string></Properties><Item class="Part"><Properties><string name="Name">Baseplate</string><Vector3 name="Size"><X>512</X><Y>16</Y><Z>512</Z></Vector3><Vector3 name="Position"><X>0</X><Y>-8</Y><Z>0</Z></Vector3><bool name="Anchored">true</bool></Properties></Item><Item class="SpawnLocation"><Properties><string name="Name">SpawnLocation</string><Vector3 name="Size"><X>12</X><Y>1</Y><Z>12</Z></Vector3><Vector3 name="Position"><X>0</X><Y>0.5</Y><Z>0</Z></Vector3><bool name="Anchored">true</bool></Properties></Item></Item><Item class="ServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script"><Properties><string name="Name">AdvancedCombatEngine</string><ProtectedString name="Source">--!strict
-- ============================================================================
-- ADVANCED COMBAT ENGINE (ACE)
-- A high-fidelity, self-contained server combat framework for Roblox Luau.
-- Features OOP State Tracking, CFrame directional validation, Spatial Hitbox queries,
-- modern Constraint Physics, and dynamic visual effects.
-- ============================================================================

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local StarterPack = game:GetService("StarterPack")

-- // SYSTEM CONFIGURATION // --
local CONFIG = {
	-- Combo settings
	COMBO_MAX = 4,
	COMBO_RESET_TIME = 1.35, -- Seconds of inactivity before resetting to swing 1
	COOLDOWN_TIME = 1.85,    -- Cooldown after completing the full combo chain
	ATTACK_INTERVAL = 0.32, -- Minimum delay allowed between consecutive hits

	-- Spatial Hitbox
	HITBOX_SIZE = Vector3.new(7, 6.5, 7.5),
	HITBOX_OFFSET = 3.8,    -- Distance in front of character to center hitbox
	DIRECTIONAL_THRESHOLD = 0.45, -- Dot product threshold (~126 degree frontal cone)

	-- Gameplay Balancing
	DAMAGE_VALUES = {10, 12, 16, 26},  -- Attack damage per combo step
	KNOCKBACK_FORCE = {18, 22, 28, 62}, -- Velocity force applied to targets
	STUN_DURATION = {0.2, 0.2, 0.3, 1.4}, -- Target walkspeed penalty durations

	-- Visual Customization
	SLASH_COLORS = {
		Color3.fromRGB(240, 240, 255), -- Swing 1: Ice White
		Color3.fromRGB(255, 220, 100), -- Swing 2: Amber Yellow
		Color3.fromRGB(120, 220, 255), -- Swing 3: Electric Blue
		Color3.fromRGB(255, 60, 60)    -- Swing 4 (Finisher): Crimson Red
	}
}

-- // COMBAT CLASS DECLARATION // --
local CombatPlayer = {}
CombatPlayer.__index = CombatPlayer

type CombatPlayerType = {
	Player: Player,
	ComboStep: number,
	LastAttackTime: number,
	OnCooldown: boolean,
	ActiveAttacks: {[Model]: boolean}
}

-- Factory Constructor to instantiate new players into the combat state machine
function CombatPlayer.new(player: Player): CombatPlayerType
	local self = setmetatable({}, CombatPlayer) :: any
	self.Player = player
	self.ComboStep = 1
	self.LastAttackTime = 0
	self.OnCooldown = false
	self.ActiveAttacks = {}
	return self
end

-- Checks if a player is in a valid state to execute an attack
function CombatPlayer:CanAttack(): boolean
	local character = self.Player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		return false
	end
	
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return false
	end
	
	local now = os.clock()
	if self.OnCooldown then
		return false
	end
	
	if now - self.LastAttackTime &lt; CONFIG.ATTACK_INTERVAL then
		return false
	end
	
	return true
end

-- Progresses the combo sequence and initiates timers
function CombatPlayer:TriggerSwing()
	local now = os.clock()
	
	-- Reset combo to 1 if the player waited too long between swings
	if now - self.LastAttackTime &gt; CONFIG.COMBO_RESET_TIME then
		self.ComboStep = 1
	end
	
	self.LastAttackTime = now
	local currentStep = self.ComboStep
	
	-- Update state for the next swing
	if currentStep &gt;= CONFIG.COMBO_MAX then
		self.OnCooldown = true
		self.ComboStep = 1
		task.delay(CONFIG.COOLDOWN_TIME, function()
			self.OnCooldown = false
		end)
	else
		self.ComboStep = currentStep + 1
	end
	
	-- Execute the combat mechanics for this swing
	self:ExecuteSwing(currentStep)
end

-- Creates visual slash effects using basic parts and TweenService
local function createSlashVFX(cframe: CFrame, step: number)
	local slash = Instance.new("Part")
	slash.Name = "SlashVFX"
	slash.Anchored = true
	slash.CanCollide = false
	slash.CastShadow = false
	slash.Material = Enum.Material.Neon
	slash.Color = CONFIG.SLASH_COLORS[step]
	slash.Shape = Enum.PartType.Block
	slash.Transparency = 0.25
	slash.Size = Vector3.new(0.1, 0.1, 0.1)
	
	-- Add visual variation with random roll offsets
	slash.CFrame = cframe * CFrame.Angles(0, 0, math.rad(math.random(-15, 15)))
	slash.Parent = workspace
	
	local targetSize = Vector3.new(CONFIG.HITBOX_SIZE.X * 0.9, 0.15, 2.5)
	local tweenInfo = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	local tween = TweenService:Create(slash, tweenInfo, {
		Size = targetSize,
		Transparency = 1,
		CFrame = slash.CFrame * CFrame.new(0, 0, -2.2)
	})
	
	tween:Play()
	Debris:AddItem(slash, 0.3)
end

-- Dynamic particle burst helper for target impacts
local function createImpactVFX(position: Vector3, color: Color3)
	local attachment = Instance.new("Attachment")
	attachment.Position = position
	attachment.Parent = workspace.Terrain
	
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.65),
		NumberSequenceKeypoint.new(1, 0)
	})
	emitter.Speed = NumberRange.new(8, 22)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.18, 0.35)
	emitter.Rate = 0
	emitter.Parent = attachment
	
	emitter:Emit(14)
	Debris:AddItem(attachment, 0.5)
end

-- Generates 3D floating text above the hit target to represent damage
local function createDamageText(position: Vector3, amount: number, isFinisher: boolean)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "DamageLabel"
	billboard.Size = UDim2.fromOffset(80, 25)
	billboard.StudsOffsetWorldSpace = position + Vector3.new(0, 1.8, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = workspace.Terrain
	
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = tostring(amount)
	label.TextColor3 = isFinisher and Color3.fromRGB(255, 45, 45) or Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextStrokeTransparency = 0.3
	label.Parent = billboard
	
	-- Calculate randomized drift arc
	local driftOffset = Vector3.new(math.random(-2.5, 2.5), 3.5, math.random(-2.5, 2.5))
	local tweenInfo = TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	
	TweenService:Create(billboard, tweenInfo, {
		StudsOffsetWorldSpace = billboard.StudsOffsetWorldSpace + driftOffset
	}):Play()
	
	TweenService:Create(label, tweenInfo, {
		TextTransparency = 1,
		TextStrokeTransparency = 1
	}):Play()
	
	Debris:AddItem(billboard, 0.6)
end

-- Uses modern constraint physics to knock targets back smoothly
function CombatPlayer:ApplyKnockback(targetRoot: BasePart, direction: Vector3, force: number)
	-- Remove old knockback vectors to prevent physics stacking
	for _, child in ipairs(targetRoot:GetChildren()) do
		if child.Name == "ACE_Knockback" or child.Name == "ACE_Attachment" then
			child:Destroy()
		end
	end
	
	local attachment = Instance.new("Attachment")
	attachment.Name = "ACE_Attachment"
	attachment.Parent = targetRoot
	
	local linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Name = "ACE_Knockback"
	linearVelocity.Attachment0 = attachment
	linearVelocity.MaxForce = 185000 -- Overrides target friction and weight
	
	-- Apply movement along the computed vector with a slight upward lift
	linearVelocity.VectorVelocity = (direction * force) + Vector3.new(0, force * 0.12, 0)
	linearVelocity.Parent = targetRoot
	
	Debris:AddItem(linearVelocity, 0.22)
	Debris:AddItem(attachment, 0.22)
end

-- Stuns the target by freezing speed and flashing health UI colors
function CombatPlayer:ApplyStun(targetHumanoid: Humanoid, duration: number)
	local char = targetHumanoid.Parent
	if not char then return end
	
	-- Fire status changes if a custom attribute system is linked
	char:SetAttribute("Stunned", true)
	local originalSpeed = targetHumanoid.WalkSpeed
	targetHumanoid.WalkSpeed = math.max(0, originalSpeed - 12) -- Reduce movement speed
	
	task.delay(duration, function()
		if targetHumanoid and targetHumanoid.Parent then
			targetHumanoid.WalkSpeed = originalSpeed
			char:SetAttribute("Stunned", nil)
		end
	end)
end

-- Performs spatial overlap query to find targets inside the frontal box hitbox
function CombatPlayer:ScanHitbox(root: BasePart, step: number): {Model}
	local centerCFrame = root.CFrame * CFrame.new(0, 0, -CONFIG.HITBOX_OFFSET)
	
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {self.Player.Character}
	params.MaxParts = 60
	
	local hits = workspace:GetPartBoundsInBox(centerCFrame, CONFIG.HITBOX_SIZE, params)
	local scannedModels = {}
	local validTargets = {}
	
	for _, part in ipairs(hits) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and not scannedModels[model] then
			scannedModels[model] = true
			
			local targetHumanoid = model:FindFirstChildOfClass("Humanoid")
			local targetRoot = model:FindFirstChild("HumanoidRootPart")
			
			if targetHumanoid and targetRoot and targetHumanoid.Health &gt; 0 then
				-- Calculate direction vector and dot product for directional verification
				local toTarget = (targetRoot.Position - root.Position).Unit
				local attackerFacing = root.CFrame.LookVector
				local alignment = toTarget:Dot(attackerFacing)
				
				-- Ensure target is within the front angle threshold
				if alignment &gt;= CONFIG.DIRECTIONAL_THRESHOLD then
					table.insert(validTargets, model)
				end
			end
		end
	end
	
	return validTargets
end

-- Main combat logic flow called per combo step swing
function CombatPlayer:ExecuteSwing(step: number)
	local character = self.Player.Character
	if not character then return end
	
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
	if not root then return end
	
	-- Render local slash VFX
	local slashCFrame = root.CFrame * CFrame.new(0, 0, -CONFIG.HITBOX_OFFSET + 1)
	createSlashVFX(slashCFrame, step)
	
	-- Capture targets in frontal hitbox
	local targets = self:ScanHitbox(root, step)
	
	for _, target in ipairs(targets) do
		local targetHumanoid = target:FindFirstChildOfClass("Humanoid")
		local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart
		
		if targetHumanoid and targetRoot then
			local damage = CONFIG.DAMAGE_VALUES[step]
			local force = CONFIG.KNOCKBACK_FORCE[step]
			local stun = CONFIG.STUN_DURATION[step]
			
			-- Inflict damage
			targetHumanoid:TakeDamage(damage)
			
			-- Render visual hit markers
			createImpactVFX(targetRoot.Position, CONFIG.SLASH_COLORS[step])
			createDamageText(targetRoot.Position, damage, step == CONFIG.COMBO_MAX)
			
			-- Apply movement physics
			local kbDirection = (targetRoot.Position - root.Position).Unit
			if kbDirection.Magnitude &lt; 0.05 then
				kbDirection = root.CFrame.LookVector
			end
			self:ApplyKnockback(targetRoot, kbDirection, force)
			
			-- Inflict stun walkspeed debuff
			self:ApplyStun(targetHumanoid, stun)
		end
	end
end

-- // CLIENT LOADER SETUP // --
-- This self-installing local listener monitors inputs and fires activation signals
local function installClientScript()
	local localScript = Instance.new("LocalScript")
	localScript.Name = "ACE_ClientController"
	
	localScript.Source = [[
		local Players = game:GetService("Players")
		local UIS = game:GetService("UserInputService")
		local player = Players.LocalPlayer
		
		-- Wait for tool instance
		local tool = script.Parent
		if not tool:IsA("Tool") then return end
		
		-- Setup client activation visual hints
		tool.Activated:Connect(function()
			-- In a standard replication setup, local swing animations would trigger here.
			-- Client side click triggers activation on the tool, which replicates tool.Activated to the server.
		end)
	]]
	
	return localScript
end

-- // SYSTEM BOOT / INITIALIZATION // --
local combatRegistry = {}

local function registerPlayer(player: Player)
	combatRegistry[player] = CombatPlayer.new(player)
end

local function removePlayer(player: Player)
	combatRegistry[player] = nil
end

-- Dynamic weapon creation to put in the player's inventory
local function createKatanaTool()
	local tool = Instance.new("Tool")
	tool.Name = "Combat Katana"
	tool.RequiresHandle = true
	tool.ToolTip = "Left Click to execute combos!"
	
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.4, 0.4, 4.5)
	handle.Material = Enum.Material.Metal
	handle.Color = Color3.fromRGB(40, 40, 42)
	handle.Parent = tool
	
	local blade = Instance.new("Part")
	blade.Name = "Blade"
	blade.Size = Vector3.new(0.1, 0.35, 4.0)
	blade.Material = Enum.Material.Neon
	blade.Color = Color3.fromRGB(240, 240, 255)
	blade.CanCollide = false
	blade.CFrame = handle.CFrame * CFrame.new(0, 0, -2.2)
	blade.Parent = tool
	
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = blade
	weld.Parent = handle
	
	-- Inject the local controller script
	local clientCtrl = installClientScript()
	clientCtrl.Parent = tool
	
	return tool
end

-- Setup and verify tool presence in the game assets
local function initializeStarterWeapon()
	local toolExists = StarterPack:FindFirstChild("Combat Katana")
	if not toolExists then
		local sword = createKatanaTool()
		sword.Parent = StarterPack
	end
end

-- Spawns functional test training dummies with floating HP status indicators
local function spawnTrainingDummy(position: Vector3)
	local dummy = Instance.new("Model")
	dummy.Name = "Training Dummy"
	
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 300
	humanoid.Health = 300
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.Parent = dummy
	
	-- Construct R6 structural body parts
	local function createPart(name: string, size: Vector3, color: Color3): Part
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = color
		part.Material = Enum.Material.SmoothPlastic
		part.Anchored = false
		part.CanCollide = true
		part.Parent = dummy
		return part
	end
	
	local hrp = createPart("HumanoidRootPart", Vector3.new(2, 2, 1), Color3.fromRGB(120, 120, 120))
	local torso = createPart("Torso", Vector3.new(2, 2, 1), Color3.fromRGB(45, 120, 210))
	local head = createPart("Head", Vector3.new(1.2, 1.2, 1.2), Color3.fromRGB(255, 220, 150))
	local rArm = createPart("Right Arm", Vector3.new(1, 2, 1), Color3.fromRGB(45, 120, 210))
	local lArm = createPart("Left Arm", Vector3.new(1, 2, 1), Color3.fromRGB(45, 120, 210))
	local rLeg = createPart("Right Leg", Vector3.new(1, 2, 1), Color3.fromRGB(80, 80, 80))
	local lLeg = createPart("Left Leg", Vector3.new(1, 2, 1), Color3.fromRGB(80, 80, 80))
	
	dummy.PrimaryPart = hrp
	hrp.CFrame = CFrame.new(position)
	
	-- Rig connections
	local jointOffsets = {
		[torso] = CFrame.new(0, 0, 0),
		[head] = CFrame.new(0, 1.6, 0),
		[rArm] = CFrame.new(1.5, 0, 0),
		[lArm] = CFrame.new(-1.5, 0, 0),
		[rLeg] = CFrame.new(0.5, -2, 0),
		[lLeg] = CFrame.new(-0.5, -2, 0)
	}
	
	for part, offset in pairs(jointOffsets) do
		part.CFrame = hrp.CFrame * offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = hrp
		weld.Part1 = part
		weld.Parent = dummy
	end
	
	-- Create modern glassmorphic status UI billboard
	local ui = Instance.new("BillboardGui")
	ui.Name = "StatusBillboard"
	ui.Size = UDim2.fromOffset(120, 18)
	ui.StudsOffset = Vector3.new(0, 3.8, 0)
	ui.AlwaysOnTop = true
	ui.Adornee = hrp
	ui.Parent = hrp
	
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	bg.BorderSizePixel = 0
	bg.Parent = ui
	Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 6)
	
	local barBg = Instance.new("Frame")
	barBg.Size = UDim2.new(1, -6, 1, -6)
	barBg.Position = UDim2.new(0, 3, 0, 3)
	barBg.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	barBg.BorderSizePixel = 0
	barBg.Parent = bg
	Instance.new("UICorner", barBg).CornerRadius = UDim.new(0, 4)
	
	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.BackgroundColor3 = Color3.fromRGB(70, 210, 100)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBg
	Instance.new("UICorner", barFill).CornerRadius = UDim.new(0, 4)
	
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.fromRGB(255, 255, 255)
	text.Font = Enum.Font.GothamBold
	text.TextSize = 10
	text.Text = "HP: 300 / 300"
	text.Parent = barBg
	
	-- Dynamically updates target status overhead UI
	local function updateUI()
		local hpRatio = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		local isStunned = dummy:GetAttribute("Stunned")
		
		local targetColor = Color3.fromRGB(70, 210, 100)
		if isStunned then
			targetColor = Color3.fromRGB(170, 70, 240) -- Stun Purple
		elseif hpRatio &lt; 0.35 then
			targetColor = Color3.fromRGB(230, 65, 65) -- Danger Red
		elseif hpRatio &lt; 0.65 then
			targetColor = Color3.fromRGB(240, 180, 50) -- Mid Yellow
		end
		
		TweenService:Create(barFill, TweenInfo.new(0.12), {
			Size = UDim2.fromScale(hpRatio, 1),
			BackgroundColor3 = targetColor
		}):Play()
		
		text.Text = isStunned and "STUNNED" or string.format("HP: %d / %d", math.floor(humanoid.Health), humanoid.MaxHealth)
	end
	
	humanoid:GetPropertyChangedSignal("Health"):Connect(updateUI)
	dummy:GetAttributeChangedSignal("Stunned"):Connect(updateUI)
	
	-- Clean respawning trigger
	humanoid.Died:Connect(function()
		task.wait(2.2)
		dummy:Destroy()
		spawnTrainingDummy(position)
	end)
	
	dummy.Parent = workspace
end

-- Binds player tools to the Combat registry methods
local function bindCombatTool(tool: Tool, player: Player)
	tool.Activated:Connect(function()
		local data = combatRegistry[player]
		if data and data:CanAttack() then
			data:TriggerSwing()
		end
	end)
end

-- Set up listeners for connections
Players.PlayerAdded:Connect(function(player)
	registerPlayer(player)
	player.CharacterAdded:Connect(function(character)
		-- Bind tools spawned inside inventory
		character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child.Name == "Combat Katana" then
				bindCombatTool(child, player)
			end
		end)
	end)
	player.Backpack.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Combat Katana" then
			bindCombatTool(child, player)
		end
	end)
end)

Players.PlayerRemoving:Connect(removePlayer)

-- Initialize components for active users in case of hot-reloads
for _, player in ipairs(Players:GetPlayers()) do
	registerPlayer(player)
	if player.Character then
		player.Character.ChildAdded:Connect(function(child)
			if child:IsA("Tool") and child.Name == "Combat Katana" then
				bindCombatTool(child, player)
			end
		end)
	end
end

-- Launch initialization tasks
initializeStarterWeapon()
spawnTrainingDummy(Vector3.new(0, 3, -15))
spawnTrainingDummy(Vector3.new(8, 3, -13))
spawnTrainingDummy(Vector3.new(-8, 3, -13))

print("[ACE] Advanced Combat Engine initialized successfully.")
</ProtectedString></Properties></Item></Item></roblox>